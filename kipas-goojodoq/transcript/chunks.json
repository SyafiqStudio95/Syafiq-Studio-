 "c2": [
  {
   "a": 0.0,
   "b": 4.7,
   "text": "Aduh, asyik lupa cas kipas. Bila nak guna, bateri pula habis."
  },
  {
   "a": 5.02,
   "b": 9.44,
   "text": "Panas lagi, peluh lagi, geramnya. Mulai hari ni tak payah cas lagi."
  },
  {
   "a": 9.74,
   "b": 10.3,
   "text": "Kenalkan."
  },
  {
   "a": 10.56,
   "b": 12.8,
   "text": "GOJOEDOQ USB High Speed Mini Fan."
  },
  {
   "a": 13.2,
   "b": 14.26,
   "text": "Kipas ni tak ada bateri."
  },
  {
   "a": 14.7,
   "b": 15.62,
   "text": "Jadi tak perlu cas."
  },
  {
   "a": 16.2,
   "b": 18.44,
   "text": "Cucuk sahaja pada port USB Type-C,"
  },
  {
   "a": 18.8,
   "b": 21.34,
   "text": "dekat telefon, tablet, power bank atau laptop."
  },
  {
   "a": 21.8,
   "b": 24.36,
   "text": "Dan dalam beberapa saat, angin sejuk terus bertiup."
  },
  {
   "a": 24.82,
   "b": 26.52,
   "text": "Plug and play, semudah itu saja."
  },
  {
   "a": 26.94,
   "b": 32.44,
   "text": "Kelajuan angin boleh dilaras ikut selesa anda. Saiznya kecil tapi anginnya laju dan padu."
  },
  {
   "a": 32.78,
   "b": 34.36,
   "text": "Ringan dan kompak, muak nak bawa."
  },
  {
   "a": 34.58,
   "b": 36.32,
   "text": "Letak dalam beg, letak dalam poket pun muak."
  },
  {
   "a": 36.82,
   "b": 40.1,
   "text": "Sesuai anda nak bawa ke ofis ke, nak pergi kelas, bercuti."
  },
  {
   "a": 40.42,
   "b": 42.64,
   "text": "Atau masa nak naik transit train pun boleh."
  },
  {
   "a": 42.88,
   "b": 45.64,
   "text": "Selagi telefon ada dekat tangan anda ataupun power bank."
  },
  {
   "a": 46.26,
   "b": 47.38,
   "text": "Anda akan kekal."
  },
  {
   "a": 47.72,
   "b": 49.46,
   "text": "Rasa sejuk tu dengan kipas."
  },
  {
   "a": 50.2,
   "b": 51.24,
   "text": "Jadi, jangan risau lagi."
  },
  {
   "a": 51.7,
   "b": 54.16,
   "text": "Belilah GOJOEDOQ High Speed USB Mini Fan."
  },
  {
   "a": 54.46,
   "b": 56.7,
   "text": "Tak perlu cas lagi. Senang nak bawa ke mana-mana."
  },
  {
   "a": 57.04,
   "b": 59.14,
   "text": "Dapatkan sekarang. Tekan beg kuning sekarang."
  }
 ]
