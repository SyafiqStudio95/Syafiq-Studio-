 "c3": [
  {
   "a": 0.0,
   "b": 6.36,
   "text": "Tak semua bola itu bulat. Ada juga keadaan lepeh macam ni. Ini dah hoverball. Khas untuk anda."
  },
  {
   "a": 6.74,
   "b": 8.82,
   "text": "Aktiviti Indo dalam rumah."
  },
  {
   "a": 9.4,
   "b": 10.32,
   "text": "Jadi, anak-anak"
  },
  {
   "a": 10.62,
   "b": 14.28,
   "text": "anda yang aktif, yang lasak, yang suka main bola, jangan risau."
  },
  {
   "a": 14.88,
   "b": 27.2,
   "text": "Boleh dapatkan hover ball ni sebagai aktiviti anda bersama dengan anak-anak. Apa yang menarik pasal hover ball ni, boleh tengok dari sudut kualiti dia, bump dia dekat bahagian tepi ni sangat lembut. Jadi, tak ada masalah akan merosakkan dini rumah, tak ada masalah."
  },
  {
   "a": 27.48,
   "b": 30.66,
   "text": "Dan hover ball kat sini, kita nampak kat dalam ni ada kipas."
  },
  {
   "a": 31.02,
   "b": 32.42,
   "text": "Bila ada kipas kat sini,"
  },
  {
   "a": 32.64,
   "b": 33.2,
   "text": "angin,"
  },
  {
   "a": 33.56,
   "b": 36.36,
   "text": "daripada atas akan masuk yang menolak ke bahagian bawah."
  },
  {
   "a": 36.82,
   "b": 40.3,
   "text": "Menyebabkan hover ball ini akan terapung dan dia akan bergerak secara otomatik."
  },
  {
   "a": 40.78,
   "b": 49.08,
   "text": "Terima kasih kerana menonton!"
  },
  {
   "a": 49.36,
   "b": 51.34,
   "text": "Siapa yang berminat dapatkan hover ball?"
  },
  {
   "a": 51.94,
   "b": 53.7,
   "text": "khas untuk anak-anak yang lasak."
  },
  {
   "a": 54.16,
   "b": 56.34,
   "text": "Berikan mereka kebebasan nak main."
  },
  {
   "a": 56.74,
   "b": 58.56,
   "text": "Tapi main adalah keadaan selamat dalam rumah."
  },
  {
   "a": 59.08,
   "b": 60.54,
   "text": "Boleh dapatkan Hover Ball."
  },
  {
   "a": 61.12,
   "b": 63.0,
   "text": "Kualiti yang bagus, harga yang murah."
  },
  {
   "a": 63.48,
   "b": 65.0,
   "text": "Tekan beg kuning sekarang."
  }
