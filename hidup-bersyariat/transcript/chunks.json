  },
  {
   "a": 8.64,
   "b": 10.4,
   "text": "Kerana indahnya Hidup Bersyariat."
  },
  {
   "a": 10.74,
   "b": 16.42,
   "text": "Modul fardu ain dan keluarga dan masyarakat sepanjang hayat adalah satu buku yang sangat lengkap."
  },
  {
   "a": 16.68,
   "b": 17.9,
   "text": "Daripada sudut"
