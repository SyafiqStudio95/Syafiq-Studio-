   "b": 51.22,
   "text": "panduannya sangat macam kita nak tengok encyclopedia"
  },
  {
   "a": 51.82,
   "b": 52.26,
   "text": "nampak tak?"
  },
  {
   "a": 53.02,
   "b": 53.52,
   "text": "Tak."
  },
  {
   "a": 54.2,
