  },
  {
   "a": 43.62,
   "b": 43.96,
   "text": "kemudian"
  },
  {
   "a": 44.18,
   "b": 47.4,
   "text": "menjadi mudah bagi kita nak baca, nak tengok."
  },
  {
   "a": 47.62,
   "b": 47.82,
   "text": "Sari kata oleh SDI Media"
  },
  {
